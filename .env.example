PORT=5000

# log
LOG_LEVEL= info #info,debug,error,warn
LOG_OUTPUT= console # 'console', 'file', or 'console,file'
LOG_FILE_PATH=logs/app.log

# ai chat model
NVIDIA_API_KEY=xxxxxxxxxxxxxx
NVIDIA_AI_MODEL="xxxxxxxxxxxxxx"
BASE_URL= "xxxxxxxxxxxxxxxxxx"
TEMPERATURE=0.2
TOP_P=0.7
MAX_TOKENS=2048

# auth / google oauth
# Public base URL of the app.
APP_URL=http://localhost:5000
# "Web application" OAuth client ID from Google Cloud Console -> Credentials.
# The backend verifies native ID tokens against this (and optionally the
# Android/iOS client IDs) as accepted audiences.
GOOGLE_CLIENT_ID_WEB=xxxxxxxxxxxxxx.apps.googleusercontent.com
# Optional: Android OAuth client ID (SHA-1 bound). Leave empty if unused.
GOOGLE_CLIENT_ID_ANDROID=
# Optional: iOS OAuth client ID. Leave empty if unused.
GOOGLE_CLIENT_ID_IOS=

# jwt
# REQUIRED when NODE_ENV=production - the server refuses to start without it.
# Generate one, e.g.: openssl rand -hex 32
JWT_SECRET=xxxxxxxxxxxxxx
# Optional dedicated secret for refresh tokens. Falls back to JWT_SECRET when empty.
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# database
MONGODB_URI=mongodb://localhost:27017/SHEild

# runtime environment: dev | stg | prod ("production" is also honoured for the JWT_SECRET check)
NODE_ENV=dev
