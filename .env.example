PORT=5000

# log
LOG_LEVEL= info #info,debug,error,warn
LOG_OUTPUT= console # 'console', 'file', or 'console,file'
LOG_FILE_PATH=logs/app.log

# ai chat model
NVIDIA_API_KEY=xxxxxxxxxxxxxx
NVIDIA_AI_MODEL="xxxxxxxxxxxxxx"
BASE_URL= "xxxxxxxxxxxxxxxxxx"
TEMPERATURE=0.2
TOP_P=0.7
MAX_TOKENS=2048

# auth / appwrite
# Public base URL of the app (used as the OAuth callback origin).
# A loopback value (localhost/127.x/[::1]) is only a convenience: when the app
# calls the API from another host, the callback is rewritten to that host so the
# device browser can load it. Non-loopback values are used as-is.
APP_URL=http://localhost:5000
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=xxxxxxxxxxxxxx
# Admin API key (server only). Never commit the real .env.
APPWRITE_API_KEY=xxxxxxxxxxxxxx

# jwt
# REQUIRED when NODE_ENV=production - the server refuses to start without it.
# Generate one, e.g.: openssl rand -hex 32
JWT_SECRET=xxxxxxxxxxxxxx
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# database
MONGODB_URI=mongodb://localhost:27017/SHEild

# runtime environment: dev | stg | prod ("production" is also honoured for the JWT_SECRET check)
NODE_ENV=dev
